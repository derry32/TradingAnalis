#!/usr/bin/expect -f
set timeout 30

spawn ssh -o StrictHostKeyChecking=no ubuntu@43.156.79.235 {
    echo "=== 1. Kill any existing MetaEditor ==="
    sudo docker exec ai-mt5-vnc pkill -9 -f metaeditor64.exe || true
    sleep 2

    echo "=== 2. Re-open MetaEditor with updated AurumAI_Executor.mq5 ==="
    sudo docker exec -u kasm-user -d -e DISPLAY=:1 -e WINEPREFIX=/headless/.wine ai-mt5-vnc wine '/headless/.wine/drive_c/Program Files/MetaTrader 5/metaeditor64.exe' 'C:\Program Files\MetaTrader 5\MQL5\Experts\AurumAI_Executor.mq5'
    sleep 5

    echo "=== 3. Send F7 Compile Key ==="
    sudo docker exec -u kasm-user -e DISPLAY=:1 ai-mt5-vnc bash -c 'WID=$(xdotool search --onlyvisible --name "MetaEditor" | head -1); if [ -n "$WID" ]; then xdotool windowactivate --sync $WID; sleep 1; xdotool key F7; fi'
    sleep 3

    echo "=== 4. Check compile log ==="
    sudo docker exec ai-mt5-vnc iconv -f UTF-16LE -t UTF-8 '/headless/.wine/drive_c/Program Files/MetaTrader 5/logs/metaeditor.log' | tail -n 8
}
expect {
    "password:" { send "thunder-29%-quantum\r"; exp_continue }
    eof
}
