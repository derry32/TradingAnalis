send "echo 'Wine setup FINISHED!'\r"
expect "$ "

# Now compile
send "sudo docker exec -u kasm-user -e DISPLAY=:1 -e WINEPREFIX=/headless/.wine ai-mt5-vnc wine 'C:\\Program Files\\MetaTrader 5\\metaeditor64.exe' '/compile:C:\\Program Files\\MetaTrader 5\\MQL5\\Experts\\AurumAI_Executor.mq5' '/log:C:\\Program Files\\MetaTrader 5\\wine10_compile.log'\r"
