#!/usr/bin/expect -f
set timeout 180

spawn ssh -o StrictHostKeyChecking=no ubuntu@43.156.79.235
expect "password:"
send "thunder-29%-quantum\r"
expect "$ "

send "while sudo docker exec ai-mt5-vnc pgrep -f rundll32 >/dev/null; do echo 'Waiting for wine setup...'; sleep 5; done\r"
