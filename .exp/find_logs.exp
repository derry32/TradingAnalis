#!/usr/bin/expect -f
set timeout 30

spawn ssh -o StrictHostKeyChecking=no ubuntu@43.156.79.235 {
    sudo docker exec ai-mt5-vnc bash -c "find '/headless/.wine/drive_c/Program Files/MetaTrader 5' -name '*.log' -mmin -10 -exec ls -la {} +"
    sudo docker exec ai-mt5-vnc bash -c "find '/headless/.wine/drive_c/Program Files/MetaTrader 5' -name 'AurumAI_Executor.log' -exec iconv -f UTF-16LE -t UTF-8 {} +"
}
expect {
    "password:" { send "thunder-29%-quantum\r"; exp_continue }
    eof
}
