#!/usr/bin/expect -f
set timeout 60
spawn scp -o StrictHostKeyChecking=no /Users/badrinteractive/Documents/TradingAnalis/mt5/AurumAI_Executor.ex5 ubuntu@43.156.79.235:/home/ubuntu/AurumAI_Executor.ex5
expect {
    "password:" { send "thunder-29%-quantum\r"; exp_continue }
    eof
}

spawn ssh -o StrictHostKeyChecking=no ubuntu@43.156.79.235 {
echo "=== Step 1: Copy ex5 to MT5 Experts directory ==="
sudo docker cp /home/ubuntu/AurumAI_Executor.ex5 "ai-mt5-vnc:/headless/.wine/drive_c/Program Files/MetaTrader 5/MQL5/Experts/AurumAI_Executor.ex5"
sudo docker exec -u root ai-mt5-vnc chown -R kasm-user:kasm-user "/headless/.wine/drive_c/Program Files/MetaTrader 5/MQL5/Experts/AurumAI_Executor.ex5"
sudo docker exec -u root ai-mt5-vnc chmod 755 "/headless/.wine/drive_c/Program Files/MetaTrader 5/MQL5/Experts/AurumAI_Executor.ex5"

echo "=== Step 2: Restart MT5 Container ==="
sudo docker restart ai-mt5-vnc
sleep 8

echo "=== Step 3: Check MT5 Experts & Terminal log ==="
sudo docker exec ai-mt5-vnc bash -c '
today=$(date +%Y%m%d)
echo "--- Terminal Log ---"
iconv -f UTF-16LE -t UTF-8 "/headless/.wine/drive_c/Program Files/MetaTrader 5/logs/$today.log" 2>/dev/null | tail -n 25 || true
echo "--- Experts Log ---"
iconv -f UTF-16LE -t UTF-8 "/headless/.wine/drive_c/Program Files/MetaTrader 5/MQL5/logs/$today.log" 2>/dev/null | tail -n 25 || true
'
}
expect {
    "password:" { send "thunder-29%-quantum\r"; exp_continue }
    eof
}
