#!/usr/bin/expect -f
set timeout 60
spawn ssh -o StrictHostKeyChecking=no ubuntu@43.156.79.235 {
echo "=== Step 1: Copy latest clean mq5 to container ==="
sudo docker cp "/home/ubuntu/.wine/drive_c/Program Files/MetaTrader 5/MQL5/Experts/AurumAI_Executor.mq5" "ai-mt5-vnc:/headless/.wine/drive_c/Program Files/MetaTrader 5/MQL5/Experts/AurumAI_Executor.mq5"

echo "=== Step 2: Focus MetaEditor and press F7 ==="
sudo docker exec -u kasm-user -e DISPLAY=:1 ai-mt5-vnc xdotool search --name "MetaEditor" windowactivate --sync key F7
sleep 4

echo "=== Step 3: Check MQL5/Experts for .ex5 ==="
sudo docker exec ai-mt5-vnc ls -la "/headless/.wine/drive_c/Program Files/MetaTrader 5/MQL5/Experts"

echo "=== Step 4: Take screenshot ==="
sudo docker exec -u kasm-user -e DISPLAY=:1 ai-mt5-vnc xwd -root -silent -out /tmp/screen5.xwd
sudo docker cp ai-mt5-vnc:/tmp/screen5.xwd /tmp/screen5.xwd
}
expect {
    "password:" { send "thunder-29%-quantum\r"; exp_continue }
    eof
}
