#!/usr/bin/expect -f
set timeout 30

spawn ssh -o StrictHostKeyChecking=no ubuntu@43.156.79.235 {
    echo "=== 1. Send Enter to accept file reload modal ==="
    sudo docker exec -u kasm-user -e DISPLAY=:1 ai-mt5-vnc xdotool key Return
    sleep 2
    
    echo "=== 2. Send F7 to compile ==="
    sudo docker exec -u kasm-user -e DISPLAY=:1 ai-mt5-vnc xdotool key F7
    sleep 4

    echo "=== 3. Check MetaEditor Compile Log ==="
    sudo docker exec ai-mt5-vnc iconv -f UTF-16LE -t UTF-8 '/headless/.wine/drive_c/Program Files/MetaTrader 5/logs/metaeditor.log' | tail -n 8

    echo "=== 4. Check if AurumAI_Executor.ex5 exists ==="
    sudo docker exec ai-mt5-vnc ls -la '/headless/.wine/drive_c/Program Files/MetaTrader 5/MQL5/Experts/'
}
expect {
    "password:" { send "thunder-29%-quantum\r"; exp_continue }
    eof
}
