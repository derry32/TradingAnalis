#!/usr/bin/expect -f
set timeout 60
spawn ssh -o StrictHostKeyChecking=no ubuntu@43.156.79.235 {
sudo docker exec -u kasm-user -e WINEPREFIX=/headless/.wine ai-mt5-vnc wine reg query "HKEY_LOCAL_MACHINE\\Software\\Microsoft\\Windows NT\\CurrentVersion" 2>/dev/null || true
sudo docker exec -u kasm-user -e WINEPREFIX=/headless/.wine ai-mt5-vnc wine --version
}
expect {
    "password:" { send "thunder-29%-quantum\r"; exp_continue }
    eof
}
