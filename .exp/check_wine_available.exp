#!/usr/bin/expect -f
set timeout 30
spawn ssh -o StrictHostKeyChecking=no ubuntu@43.156.79.235 {
sudo docker exec -u root ai-mt5-vnc bash -c "
# Check what wine packages are available in the winehq repo
apt-cache policy wine-staging 2>/dev/null || true
apt-cache search wine | grep -i staging | head -5
"
}
expect {
    "password:" { send "thunder-29%-quantum\r"; exp_continue }
    eof
}
