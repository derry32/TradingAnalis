#!/usr/bin/expect -f
set timeout 45

spawn ssh -o StrictHostKeyChecking=no ubuntu@43.156.79.235
expect "password:"
send "thunder-29%-quantum\r"
expect "$ "

# Close Mono dialogs by sending Escape to each window
send "sudo docker exec -u kasm-user -e DISPLAY=:1 ai-mt5-vnc bash -c '
  for wid in \$(wmctrl -l | grep -i \"Mono\" | awk \"{print \\\$1}\"); do
    echo \"Dismissing Mono dialog: \$wid\"
    xdotool windowactivate --sync \$wid key Escape
    sleep 0.5
  done
'\r"
expect "$ "
sleep 2

# Now focus MetaEditor and compile
send "sudo docker exec -u kasm-user -e DISPLAY=:1 ai-mt5-vnc bash -c '
  WID=\$(wmctrl -l | grep -i \"MetaEditor\" | awk \"{print \\\$1}\" | head -1)
  echo \"MetaEditor WID: \$WID\"
  xdotool windowactivate --sync \$WID
  sleep 1
  xdotool key F7
  sleep 6
  echo COMPILED_VIA_F7
'\r"
expect "$ "

# Read log
send "sudo docker exec ai-mt5-vnc iconv -f UTF-16LE -t UTF-8 '/headless/.wine/drive_c/Program Files/MetaTrader 5/logs/metaeditor.log' | tail -n 6\r"
expect "$ "

# Check if .ex5 exists
send "sudo docker exec ai-mt5-vnc ls -la '/headless/.wine/drive_c/Program Files/MetaTrader 5/MQL5/Experts/'\r"
expect "$ "

send "exit\r"
expect eof
