#!/usr/bin/expect -f
set timeout 90

spawn ssh -o StrictHostKeyChecking=no ubuntu@43.156.79.235
expect "password:"
send "thunder-29%-quantum\r"
expect "$ "

# Kill any running MetaEditor first
send "sudo docker exec ai-mt5-vnc pkill -9 -f metaeditor64.exe 2>/dev/null || true\r"
expect "$ "
sleep 1

# Start MetaEditor in background via DISPLAY - fresh open of the file
send "sudo docker exec -u kasm-user -d -e DISPLAY=:1 -e WINEPREFIX=/headless/.wine ai-mt5-vnc wine '/headless/.wine/drive_c/Program Files/MetaTrader 5/metaeditor64.exe' 'C:\\Program Files\\MetaTrader 5\\MQL5\\Experts\\AurumAI_Executor.mq5'\r"
expect "$ "

# Wait for MetaEditor to fully load (10 seconds)
sleep 10

# Now get all current window IDs
send "sudo docker exec -u kasm-user -e DISPLAY=:1 ai-mt5-vnc /usr/bin/xdotool search --name MetaEditor\r"
expect "$ "

# Click the Compile button in MetaEditor toolbar using mouse click
# The compile button in MetaEditor is "Build" menu -> Compile OR toolbar button
# Try clicking at toolbar compile button position
send "sudo docker exec -u kasm-user -e DISPLAY=:1 ai-mt5-vnc /usr/bin/xdotool mousemove 355 38 click 1\r"
expect "$ "
sleep 5

# Check compile log
send "sudo docker exec ai-mt5-vnc iconv -f UTF-16LE -t UTF-8 '/headless/.wine/drive_c/Program Files/MetaTrader 5/logs/metaeditor.log' | tail -n 6\r"
expect "$ "

# Check if .ex5 file was generated
send "sudo docker exec ai-mt5-vnc ls -la '/headless/.wine/drive_c/Program Files/MetaTrader 5/MQL5/Experts/'\r"
expect "$ "

send "exit\r"
expect eof
