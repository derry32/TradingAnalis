send "sudo docker exec ai-mt5-vnc cat '/headless/.wine/drive_c/Program Files/MetaTrader 5/MQL5/Experts/test.mq5'\r"
expect "$ "

send "sudo docker exec -u kasm-user -d -e DISPLAY=:1 -e WINEPREFIX=/headless/.wine ai-mt5-vnc wine '/headless/.wine/drive_c/Program Files/MetaTrader 5/metaeditor64.exe' 'C:\\Program Files\\MetaTrader 5\\MQL5\\Experts\\test.mq5'\r"
