#!/usr/bin/expect -f
set timeout 60
spawn scp -o StrictHostKeyChecking=no mt5/AurumAI_Executor.ex5 ubuntu@43.156.79.235:/tmp/AurumAI_Executor.ex5
expect {
    "password:" {
        send "thunder-29%-quantum\r"
        exp_continue
    }
    eof
}

spawn ssh -o StrictHostKeyChecking=no ubuntu@43.156.79.235 {
sudo docker cp /tmp/AurumAI_Executor.ex5 ai-mt5-vnc:"/headless/.wine/drive_c/Program Files/MetaTrader 5/MQL5/Experts/AurumAI_Executor.ex5"
sudo docker exec ai-mt5-vnc chown -R kasm-user:kasm-user "/headless/.wine/drive_c/Program Files/MetaTrader 5/MQL5/Experts/AurumAI_Executor.ex5"
sudo docker exec ai-mt5-vnc ls -la '/headless/.wine/drive_c/Program Files/MetaTrader 5/MQL5/Experts/'
sudo docker exec ai-mt5-vnc pkill -9 -f terminal64.exe || true
sleep 2
sudo docker exec -u kasm-user -d -e DISPLAY=:1 -e WINEPREFIX=/headless/.wine ai-mt5-vnc wine '/headless/.wine/drive_c/Program Files/MetaTrader 5/terminal64.exe'
sleep 5
sudo docker exec ai-mt5-vnc iconv -f UTF-16LE -t UTF-8 '/headless/.wine/drive_c/Program Files/MetaTrader 5/logs/20260805.log' | tail -n 25
}
expect {
    "password:" {
        send "thunder-29%-quantum\r"
        exp_continue
    }
    eof
}
