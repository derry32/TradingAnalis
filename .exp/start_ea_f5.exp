#!/usr/bin/expect -f
set timeout 30
spawn ssh -o StrictHostKeyChecking=no ubuntu@43.156.79.235 {
sudo docker exec -u kasm-user -e DISPLAY=:1 ai-mt5-vnc xdotool search --name "MetaEditor" windowactivate --sync
sleep 1
sudo docker exec -u kasm-user -e DISPLAY=:1 ai-mt5-vnc xdotool key F5
sleep 2
sudo docker exec -u kasm-user -e DISPLAY=:1 ai-mt5-vnc xdotool key Return
sleep 3
sudo docker exec ai-mt5-vnc iconv -f UTF-16LE -t UTF-8 '/headless/.wine/drive_c/Program Files/MetaTrader 5/MQL5/logs/20260805.log' | tail -n 25
}
expect {
    "password:" {
        send "thunder-29%-quantum\r"
        exp_continue
    }
    eof
}
