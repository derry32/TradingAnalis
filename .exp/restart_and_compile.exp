#!/usr/bin/expect -f
set timeout 60

spawn ssh -o StrictHostKeyChecking=no ubuntu@43.156.79.235
expect "password:"
send "thunder-29%-quantum\r"
expect "$ "

# Kill any existing MetaEditor
send "sudo docker exec ai-mt5-vnc pkill -9 -f metaeditor64.exe || true\r"
expect "$ "

# Start MetaEditor fresh with the file
send "sudo docker exec -u kasm-user -d -e DISPLAY=:1 -e WINEPREFIX=/headless/.wine ai-mt5-vnc bash -c \"wine '/headless/.wine/drive_c/Program Files/MetaTrader 5/metaeditor64.exe' 'C:\\\\Program Files\\\\MetaTrader 5\\\\MQL5\\\\Experts\\\\AurumAI_Executor.mq5' &\"\r"
expect "$ "

# Wait 8 seconds for MetaEditor to fully load
sleep 8

# Press F7 to compile
send "sudo docker exec -u kasm-user -e DISPLAY=:1 ai-mt5-vnc xdotool key F7\r"
expect "$ "

# Wait for compile
sleep 5

# Check result
send "sudo docker exec ai-mt5-vnc iconv -f UTF-16LE -t UTF-8 '/headless/.wine/drive_c/Program Files/MetaTrader 5/logs/metaeditor.log' | tail -n 4\r"
expect "$ "

send "sudo docker exec ai-mt5-vnc ls -la '/headless/.wine/drive_c/Program Files/MetaTrader 5/MQL5/Experts/'\r"
expect "$ "

send "exit\r"
expect eof
