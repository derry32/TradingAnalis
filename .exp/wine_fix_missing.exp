#!/usr/bin/expect -f
set timeout 300
spawn ssh -o StrictHostKeyChecking=no ubuntu@43.156.79.235 {
sudo docker exec -u root ai-mt5-vnc bash -c "
# Try fix-missing to skip broken kisak-mesa i386 packages
apt-get install -y --fix-missing winehq-staging 2>&1 | tail -15
wine --version
"
}
expect {
    "password:" { send "thunder-29%-quantum\r"; exp_continue }
    eof
}
