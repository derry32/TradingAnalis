#!/usr/bin/expect -f
set timeout 45

spawn scp -o StrictHostKeyChecking=no /Users/badrinteractive/Documents/TradingAnalis/mt5/AurumAI_Executor.mq5 ubuntu@43.156.79.235:/home/ubuntu/AurumAI_Executor.mq5
expect {
    "password:" { send "thunder-29%-quantum\r"; exp_continue }
    eof
}

spawn ssh -o StrictHostKeyChecking=no ubuntu@43.156.79.235
expect "password:"
send "thunder-29%-quantum\r"
expect "$ "

send "sudo docker cp /home/ubuntu/AurumAI_Executor.mq5 'ai-mt5-vnc:/headless/.wine/drive_c/Program Files/MetaTrader 5/MQL5/Experts/AurumAI_Executor.mq5'\r"
expect "$ "

send "sudo docker exec -u root ai-mt5-vnc chown -R kasm-user:kasm-user '/headless/.wine/drive_c/Program Files/MetaTrader 5/MQL5/Experts/AurumAI_Executor.mq5'\r"
expect "$ "

send "sudo docker exec ai-mt5-vnc pkill -9 -f metaeditor64.exe || true\r"
expect "$ "
sleep 1

send "sudo docker exec -u kasm-user -d -e DISPLAY=:1 -e WINEPREFIX=/headless/.wine ai-mt5-vnc wine '/headless/.wine/drive_c/Program Files/MetaTrader 5/metaeditor64.exe' 'C:\\Program Files\\MetaTrader 5\\MQL5\\Experts\\AurumAI_Executor.mq5'\r"
expect "$ "
sleep 5

send "sudo docker exec -u kasm-user -e DISPLAY=:1 ai-mt5-vnc xdotool key F7\r"
expect "$ "
sleep 4

send "sudo docker exec ai-mt5-vnc iconv -f UTF-16LE -t UTF-8 '/headless/.wine/drive_c/Program Files/MetaTrader 5/logs/metaeditor.log' | tail -n 6\r"
expect "$ "

send "sudo docker exec ai-mt5-vnc ls -la '/headless/.wine/drive_c/Program Files/MetaTrader 5/MQL5/Experts/'\r"
expect "$ "

send "exit\r"
expect eof
